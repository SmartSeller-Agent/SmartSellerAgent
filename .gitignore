# API Keys env files
.env

# Python virtual environment
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Tool caches (pytest and ruff also write their own nested .gitignore,
# listing them here makes the intent explicit and greys them out in the IDE)
.pytest_cache/
.ruff_cache/

# Build / packaging artifacts
*.egg-info/
dist/
build/

# vs code settings
.vscode/

# test images
test/images/uploads/*