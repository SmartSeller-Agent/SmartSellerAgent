# Copy to .env and adjust. Used by both flows:
#   - local run  (uv run smartselleragent) -> all values apply
#   - docker compose up                    -> see the note on the API base URLs below

# --- Mandatory ---
# Hugging Face API key (https://huggingface.co/settings/tokens)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx

# Ollama endpoint.
# NOTE: ignored when running via docker compose — the app container talks to the
# "ollama" service (http://ollama:11434/v1), set in docker-compose.yml.
OLLAMA_API_BASE="http://localhost:11434/v1"
OLLAMA_API_KEY="ollama"

# Ollama model IDs.
# These DO apply under docker compose: the ollama-init service pulls exactly
# these models on startup. Larger models mean a longer first `docker compose up`.
TEXT_MODEL_ID="qwen3:1.7b"
VISION_MODEL_ID="llava"

# Vision model — can point to a different provider than the text model
# e.g. swap to https://api.openai.com/v1 + sk-... + gpt-4o for OpenAI.
# NOTE: VISION_API_BASE is likewise overridden by docker compose.
VISION_API_BASE="http://localhost:11434/v1"
VISION_API_KEY="ollama"

# --- Optional ---
# Hugging Face model name (default: "gpt-3.5-turbo")
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# Override model ID (default: Qwen2.5-Coder-32B)
MODEL_ID=Qwen/Qwen2.5-Coder-32B-Instruct

# --- Observability ---
# Optional: if the keys are empty the agent runs without exporting traces.
LANGFUSE_PUBLIC_KEY=pk_xxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
