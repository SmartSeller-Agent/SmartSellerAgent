# Copy to .env and adjust.
#
# The system runs in one of two modes:
#
#   HOSTED — models run at OpenRouter, needs an API key, fast
#   LOCAL  — models run in an ollama container, self-contained, slow (CPU)
#
# Compose reads COMPOSE_FILE from this file, so the line below decides which
# one a plain `docker compose up` starts. HOSTED is the default because an
# agent run takes minutes there instead of tens of minutes; fill in
# OPENROUTER_API_KEY further down and it works.
COMPOSE_FILE=docker-compose.openrouter.yml
#
# Comment that line out for LOCAL mode — nothing else to change, and no key is
# needed. Without a .env at all, `docker compose up` also runs LOCAL: that is
# the self-contained path, it just downloads several GB of models first.
#
# Either mode can also be picked per command, which overrides the line above:
#
#   docker compose -f docker-compose.openrouter.yml up -> HOSTED
#   docker compose -f docker-compose.yml up            -> LOCAL
#
# Each section below says which mode it applies to.

# --- LOCAL mode: models in the ollama container ---------------------------
# The endpoint URLs are set by docker-compose.yml (the app container reaches the
# runtime as "ollama", not "localhost"), so these two only matter when you run
# the app directly on your machine with uv.
TEXT_API_BASE="http://localhost:11434/v1"
TEXT_API_KEY="ollama"

# These DO apply under docker compose: ollama-init pulls exactly these models on
# startup. Bigger models mean a longer first start and slower CPU inference.
TEXT_MODEL_ID="qwen3:1.7b"
VISION_MODEL_ID="llava"

# The vision model may sit at a different provider than the text model.
# Without these it follows TEXT_API_BASE / TEXT_API_KEY.
VISION_API_BASE="http://localhost:11434/v1"
VISION_API_KEY="ollama"

# --- HOSTED mode: OpenRouter ----------------------------------------------
# Create a key at https://openrouter.ai/keys — it starts with sk-or-v1-.
# Setting a credit limit on the key is recommended while testing.
#
# Paste it after the "=". Deliberately empty rather than a dummy value: with
# COMPOSE_FILE set to the hosted stack above, an unfilled key stops the stack
# before it starts, with a message saying so. A placeholder would start it and
# fail later on the first request with an HTTP 401 that explains nothing.
OPENROUTER_API_KEY=

# Model slugs, see https://openrouter.ai/models. Kept separate from the local
# ids above so you can switch modes without editing this file.
OPENROUTER_TEXT_MODEL="qwen/qwen3-8b"
OPENROUTER_VISION_MODEL="google/gemini-2.5-flash"

# Extra JSON sent with every chat completion. Leave unset: against OpenRouter
# the code defaults to {"reasoning": {"enabled": false}}, which is REQUIRED —
# smolagents sends tool_choice=required, and Qwen3 rejects that while reasoning
# is on ("tool_choice ... does not support being set to required ... in thinking
# mode"). Only set this if you need something different, e.g. to route around a
# provider:
#   MODEL_EXTRA_BODY={"provider":{"ignore":["Alibaba"]}}
# MODEL_EXTRA_BODY=

# --- Both modes -----------------------------------------------------------
# Read timeout for the vision call in seconds. Local CPU inference can take
# minutes; against a hosted provider a much lower value is fine.
VISION_TIMEOUT_S=600

# --- Marketplace publishing (kleinanzeigen.de) ----------------------------
# The site has no API, so the agent drives a real browser through the offer
# form. The login is stored as a Playwright storage_state file. That file
# contains valid session cookies — treat it like a password: it belongs in a
# runtime volume, never in the image and never in git.
#
# profile.json sits next to it: the settings the UI asks for on first use (the
# postcode that goes on every ad). Same lifetime as the login — it survives
# `docker compose down` and goes away with `down -v`. There is deliberately no
# environment variable for the postcode: the user enters it in the UI, and the
# language model never sees the field at all.
KLEINANZEIGEN_STATE_DIR=".state"

# SAFETY SWITCH, one of two. A public ad cannot be taken back, so publishing
# needs both hands on the trigger:
#
#   1. this variable — the operator allows it for this installation at all
#   2. the checkbox in the UI — this one run is meant to go live
#
# Either one missing means the form is only filled in and a screenshot is
# written instead. This variable can forbid but never order: with it set to
# true and nobody ticking the box, nothing is published.
#
# Neither switch is visible to the language model. The model cannot turn
# publishing on, no matter what a prompt tells it.
KLEINANZEIGEN_ALLOW_PUBLISH=false

# --- Which browser the agent drives ---------------------------------------
# DEFAULT (nothing to set here): a browser on YOUR machine. Start it in its own
# terminal and leave it open, then run the containers:
#
#   uv run python -m scripts.host_browser
#
# docker-compose.yml already points the container at it
# (KLEINANZEIGEN_BROWSER_CDP=http://host.docker.internal:9222), so this is what
# a plain `docker compose up` uses.
#
# Why: the container's browser has software rendering, almost no fonts and a
# virtual screen. kleinanzeigen.de treats it as a different device and refuses
# sessions there that work fine everywhere else. A browser on your machine
# carries the environment the site already knows, keeps the login in its own
# profile, and puts the window on your desktop.
#
# FALLBACK: the browser inside the container, watched through noVNC at
# http://localhost:6080. Needs no second terminal and no Python on the host,
# but is the path that has been refused logins. Set BOTH lines to use it — the
# empty value is what switches the host browser off:
# KLEINANZEIGEN_BROWSER_CDP=
# KLEINANZEIGEN_VNC=true
# Size of the virtual screen it draws on.
# VNC_GEOMETRY=1440x1000x24

# Headless means no visible window. On the host that is the sensible default.
# In the fallback mode above docker compose deliberately sets it to FALSE: the
# manual login needs a window, since captcha and 2FA need a human, and the
# virtual screen exists precisely so there can be one.
# KLEINANZEIGEN_HEADLESS=false
# KLEINANZEIGEN_SLOW_MO_MS=300

# How long the login waits for you to finish, in seconds. No credentials are
# ever asked for or stored — you log in yourself in the visible browser and
# only the resulting session is kept.
# KLEINANZEIGEN_LOGIN_TIMEOUT_S=300

# Chromium's own sandbox needs privileges an unprivileged container process
# does not get. docker-compose sets this to true; on the host leave it unset so
# the sandbox stays on.
# KLEINANZEIGEN_NO_SANDBOX=false

# Extra browser command line flags, written as on a shell. An escape hatch for
# experiments that would otherwise need a code change — for example pinning
# hostnames to IPv4 addresses to compare address families:
#   KLEINANZEIGEN_BROWSER_ARGS=--host-resolver-rules="MAP www.kleinanzeigen.de 1.2.3.4"
# KLEINANZEIGEN_BROWSER_ARGS=

# Waiting times in milliseconds. FIELD is for elements that are already on the
# page; SECTION is for parts the site fetches from its server (the category
# suggestions appear only after the title is entered, and the shipping options
# only after a category is picked).
# KLEINANZEIGEN_FIELD_TIMEOUT_MS=5000
# READY is the grace period after loading, before anything is typed: the page
# pulls in a saved draft during that window and silently discards whatever is
# already in the form. Raise it if titles keep getting lost.
# KLEINANZEIGEN_READY_TIMEOUT_MS=8000
# KLEINANZEIGEN_SECTION_TIMEOUT_MS=20000
# KLEINANZEIGEN_CONFIRM_TIMEOUT_MS=15000

# --- Observability (W5) ---------------------------------------------------
# Optional: if the keys are empty the agent runs without exporting traces.
# Spans are exported in batches from a background thread, so tracing does not
# slow down the agent; the server flushes what is queued when it shuts down.
LANGFUSE_PUBLIC_KEY=pk_xxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
# Debugging only: logs every span export to stdout. Leave unset/false normally.
OTEL_DEBUG_EXPORT=false

# --- Optional / legacy ----------------------------------------------------
# Older name for TEXT_API_BASE / TEXT_API_KEY, still honoured as a fallback.
# OLLAMA_API_BASE="http://localhost:11434/v1"
# OLLAMA_API_KEY="ollama"
# Hugging Face token, only needed if you switch to the HF Inference API.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
