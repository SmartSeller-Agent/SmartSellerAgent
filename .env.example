# Copy to .env and adjust.
#
# The system runs in one of two modes:
#
#   LOCAL  — models run in an ollama container, self-contained, slow (CPU)
#   HOSTED — models run at OpenRouter, needs an API key, fast
#
# Pick the mode either per command:
#
#   docker compose up                                  -> LOCAL
#   docker compose -f docker-compose.openrouter.yml up -> HOSTED
#
# ...or once here, so that plain `docker compose up` uses it every time.
# Compose reads COMPOSE_FILE from this file. Uncomment for HOSTED mode:
#
# COMPOSE_FILE=docker-compose.openrouter.yml
#
# Left commented, `docker compose up` starts the LOCAL stack — no key needed.
# Each section below says which mode it applies to.

# --- LOCAL mode: models in the ollama container ---------------------------
# The endpoint URLs are set by docker-compose.yml (the app container reaches the
# runtime as "ollama", not "localhost"), so these two only matter when you run
# the app directly on your machine with uv.
TEXT_API_BASE="http://localhost:11434/v1"
TEXT_API_KEY="ollama"

# These DO apply under docker compose: ollama-init pulls exactly these models on
# startup. Bigger models mean a longer first start and slower CPU inference.
TEXT_MODEL_ID="qwen3:1.7b"
VISION_MODEL_ID="llava"

# The vision model may sit at a different provider than the text model.
# Without these it follows TEXT_API_BASE / TEXT_API_KEY.
VISION_API_BASE="http://localhost:11434/v1"
VISION_API_KEY="ollama"

# --- HOSTED mode: OpenRouter ----------------------------------------------
# Create a key at https://openrouter.ai/keys — it starts with sk-or-v1-.
# Setting a credit limit on the key is recommended while testing.
# Required by docker-compose.openrouter.yml; it fails fast if this is missing.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Model slugs, see https://openrouter.ai/models. Kept separate from the local
# ids above so you can switch modes without editing this file.
OPENROUTER_TEXT_MODEL="qwen/qwen3-8b"
OPENROUTER_VISION_MODEL="google/gemini-2.5-flash"

# Extra JSON sent with every chat completion. Leave unset: against OpenRouter
# the code defaults to {"reasoning": {"enabled": false}}, which is REQUIRED —
# smolagents sends tool_choice=required, and Qwen3 rejects that while reasoning
# is on ("tool_choice ... does not support being set to required ... in thinking
# mode"). Only set this if you need something different, e.g. to route around a
# provider:
#   MODEL_EXTRA_BODY={"provider":{"ignore":["Alibaba"]}}
# MODEL_EXTRA_BODY=

# --- Both modes -----------------------------------------------------------
# Read timeout for the vision call in seconds. Local CPU inference can take
# minutes; against a hosted provider a much lower value is fine.
VISION_TIMEOUT_S=600

# --- Marketplace publishing (kleinanzeigen.de) ----------------------------
# The site has no API, so the agent drives a real browser through the offer
# form. The login is stored as a Playwright storage_state file. That file
# contains valid session cookies — treat it like a password: it belongs in a
# runtime volume, never in the image and never in git.
KLEINANZEIGEN_STATE_DIR=".state"

# SAFETY SWITCH. Unset or false means the form is filled in but never
# submitted, and a screenshot is written instead. Only "true"/"1"/"yes" lets a
# real, public ad be created. The value is read by the application, never by
# the language model — the model cannot turn publishing on.
# KLEINANZEIGEN_ALLOW_PUBLISH=false

# Debugging only: watch the browser work. Must stay true inside the container,
# there is no X server in there.
# KLEINANZEIGEN_HEADLESS=false
# KLEINANZEIGEN_SLOW_MO_MS=300

# Waiting times in milliseconds. FIELD is for elements that are already on the
# page; SECTION is for parts the site fetches from its server (the category
# suggestions appear only after the title is entered, and the shipping options
# only after a category is picked).
# KLEINANZEIGEN_FIELD_TIMEOUT_MS=5000
# READY is the grace period after loading, before anything is typed: the page
# pulls in a saved draft during that window and silently discards whatever is
# already in the form. Raise it if titles keep getting lost.
# KLEINANZEIGEN_READY_TIMEOUT_MS=8000
# KLEINANZEIGEN_SECTION_TIMEOUT_MS=20000
# KLEINANZEIGEN_CONFIRM_TIMEOUT_MS=15000

# --- Observability (W5) ---------------------------------------------------
# Optional: if the keys are empty the agent runs without exporting traces.
# Spans are exported in batches from a background thread, so tracing does not
# slow down the agent; the server flushes what is queued when it shuts down.
LANGFUSE_PUBLIC_KEY=pk_xxxxxxxxxxxxxxxxxxxx
LANGFUSE_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxx
LANGFUSE_HOST=https://cloud.langfuse.com
# Debugging only: logs every span export to stdout. Leave unset/false normally.
OTEL_DEBUG_EXPORT=false

# --- Optional / legacy ----------------------------------------------------
# Older name for TEXT_API_BASE / TEXT_API_KEY, still honoured as a fallback.
# OLLAMA_API_BASE="http://localhost:11434/v1"
# OLLAMA_API_KEY="ollama"
# Hugging Face token, only needed if you switch to the HF Inference API.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
